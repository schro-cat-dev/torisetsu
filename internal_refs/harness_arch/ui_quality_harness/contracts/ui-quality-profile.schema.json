{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-quality-profile.schema.json",
  "title": "UI Quality Harness Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "qualityModel",
    "target",
    "gates",
    "evidenceSources",
    "rules",
    "scenarios",
    "reviewRubric"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ui-quality-harness-profile.v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "qualityModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredGateIds"],
      "properties": {
        "requiredGateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["screen", "component", "flow", "application"]
        },
        "entrypoint": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "blocking"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "evidenceSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "adapter"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "configRef": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gateId", "assertion", "checkKind", "severity", "evidenceSourceIds", "params"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "checkKind": {
            "type": "string",
            "enum": ["auto", "semi_auto", "judgment"]
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "review"]
          },
          "evidenceSourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "params": {
            "type": "object"
          },
          "evidencePolicy": {
            "type": "string",
            "enum": ["all", "any"]
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "steps", "expectedStates"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["flow", "state", "viewport"]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "targetRef": {
                  "type": "string"
                },
                "valueRef": {
                  "type": "string"
                }
              }
            }
          },
          "expectedStates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reviewRubric": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gateId", "question", "requiredEvidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
