{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-visual-threshold-policy.schema.json",
  "title": "UI Visual Threshold Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "operator", "maxDiffPixelRatio", "unit", "scope", "rationale", "boundaryCases", "residualRisk"],
  "properties": {
    "schemaVersion": { "const": "ui-visual-threshold-policy.v1" },
    "policyId": { "type": "string", "minLength": 1 },
    "operator": { "const": "<=" },
    "maxDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "unit": { "const": "changed_pixels/total_pixels" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rationale": { "type": "string", "minLength": 1 },
    "boundaryCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actual", "expected"],
        "properties": {
          "actual": { "type": "number", "minimum": 0, "maximum": 1 },
          "expected": { "type": "string", "enum": ["passed", "failed"] }
        }
      }
    },
    "residualRisk": { "type": "string", "minLength": 1 }
  }
}
