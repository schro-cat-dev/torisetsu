{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-judgment-review.schema.json",
  "title": "UI Judgment Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "profileId", "reviewedAt", "reviewer", "evidenceArtifacts", "items"],
  "properties": {
    "schemaVersion": {
      "const": "ui-judgment-review.v1"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["human", "ai", "team"]
        }
      }
    },
    "evidenceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "artifactRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["file", "observation"] },
          "artifactRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubricId", "status", "rationale", "evidence", "openQuestions"],
        "properties": {
          "rubricId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "needs_revision"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "openQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
