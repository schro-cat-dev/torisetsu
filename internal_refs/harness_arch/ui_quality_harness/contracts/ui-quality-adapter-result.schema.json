{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-quality-adapter-result.schema.json",
  "title": "UI Quality Adapter Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "adapterId", "profileId", "evidenceSourceId", "checkedAt", "producer", "inputIdentity", "results"],
  "properties": {
    "schemaVersion": {
      "const": "ui-quality-adapter-result.v1"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "failed"]
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceSourceId": {
      "type": "string",
      "minLength": 1
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileSha256", "artifactSha256"],
      "properties": {
        "profileSha256": { "type": "string", "minLength": 1 },
        "artifactSha256": { "type": "string", "minLength": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "gateId", "status", "message", "evidence"],
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "warning", "skipped"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object"
          },
          "scenarioIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "claims": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
