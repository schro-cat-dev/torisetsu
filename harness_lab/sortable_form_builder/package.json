{
  "name": "@torisetsu/configurable-list-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "vite --host 127.0.0.1",
    "prestart:local": "npm run build:packages",
    "start:local": "node scripts/runtime.mjs start",
    "stop:local": "node scripts/runtime.mjs stop",
    "status:local": "node scripts/runtime.mjs status",
    "build:packages": "npm run build -w @torisetsu/configurable-list-core && npm run build -w @torisetsu/configurable-list-react && npm run build -w @torisetsu/configurable-list",
    "build:demo": "tsc --noEmit && vite build",
    "build": "npm run build:packages && npm run build:demo",
    "verify:package": "npm run build:packages && node scripts/verify-packed-consumer.mjs",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "npm run verify:package",
    "test:unit:local": "vitest --run"
  },
  "dependencies": {
    "@torisetsu/configurable-list": "0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
