{
  "schemaVersion": "api-contract.v1",
  "name": "todos",
  "targetFile": "local-api/data/todos.json",
  "root": {
    "type": "array",
    "items": {
      "type": "object",
      "allowUnknownFields": false,
      "required": ["id", "title", "description", "status", "priority", "categoryId", "dueDate", "completedAt", "createdAt", "updatedAt"],
      "fields": {
        "id": {
          "type": "string",
          "nonEmpty": true
        },
        "title": {
          "type": "string",
          "nonEmpty": true
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["todo", "doing", "done"]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "categoryId": {
          "type": "string",
          "nonEmpty": true
        },
        "dueDate": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
